<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="15.0" style="-fx-background-color: #121212; -fx-padding: 20;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.gymManage.controller.AgendaController">
    <children>
        <Label style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;" text="Clases Disponibles" />
        <TableView fx:id="tablaClases" prefHeight="300.0" style="-fx-background-color: #1e1e1e;">
            <columns>
                <TableColumn fx:id="colClase" prefWidth="120.0" text="Clase" />
                <TableColumn fx:id="colHorario" prefWidth="120.0" text="Horario" />
                <TableColumn fx:id="colCupos" prefWidth="100.0" text="Cupos" />
            </columns>
        </TableView>
        <Button mnemonicParsing="false" onAction="#inscribirseEnClase" style="-fx-background-color: #22c55e; -fx-text-fill: black; -fx-font-weight: bold;" text="Inscribirse en Clase" />
    </children>
</VBox>