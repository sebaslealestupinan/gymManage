<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefWidth="320.0" spacing="12.0"
      style="-fx-background-color: #ffffff; -fx-padding: 30px; -fx-background-radius: 10px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.15), 10, 0, 0, 0);"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gymManage.controller.RecuperarPasswordController">

    <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1f2937;" text="Recuperar Contraseña" />
    <Label style="-fx-font-size: 11px; -fx-text-fill: #6b7280; -fx-text-alignment: center;" text="Ingresa tu correo registrado para enviarte las instrucciones." wrapText="true" />

    <TextField fx:id="txtCorreoRecuperacion" prefHeight="35.0" prefWidth="260.0" promptText="Correo Electrónico"
               style="-fx-background-color: #f9fafb; -fx-border-color: #d1d5db; -fx-border-radius: 5px; -fx-background-radius: 5px; -fx-padding: 5px 10px;" />

    <Button onAction="#enviarCorreoRecuperacion" prefHeight="38.0" prefWidth="260.0"
            style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-background-radius: 5px; -fx-cursor: hand;"
            text="Enviar Instrucciones">
        <VBox.margin>
            <Insets top="5.0" />
        </VBox.margin>
    </Button>

    <Hyperlink onAction="#volverAlLogin" style="-fx-text-fill: #2563eb; -fx-font-size: 11px;" text="Volver al Inicio de Sesión" />

    <Label fx:id="lblMensaje" style="-fx-text-fill: #dc2626; -fx-font-size: 12px;" />

</VBox>