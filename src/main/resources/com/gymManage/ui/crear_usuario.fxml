<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefWidth="340.0" spacing="10.0"
      style="-fx-background-color: #ffffff; -fx-padding: 25px; -fx-background-radius: 10px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.15), 10, 0, 0, 0);"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gymManage.controller.CrearUsuarioController">

    <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1f2937;" text="Crear Nueva Cuenta" />
    <Label style="-fx-font-size: 11px; -fx-text-fill: #6b7280;" text="Ingresa tus datos para registrarte" />

    <ComboBox fx:id="cmbRolRegistro" prefHeight="35.0" prefWidth="280.0" promptText="Seleccionar Tipo de Usuario"
              style="-fx-background-color: #f9fafb; -fx-border-color: #d1d5db; -fx-border-radius: 5px; -fx-background-radius: 5px;">
        <items>
            <FXCollections fx:factory="observableArrayList">
                <String fx:value="Cliente" />
                <String fx:value="Entrenador" />
                <String fx:value="Usuario Administrativo" />
            </FXCollections>
        </items>
    </ComboBox>

    <TextField fx:id="txtNombreCompleto" prefHeight="35.0" prefWidth="280.0" promptText="Nombre Completo"
               style="-fx-background-color: #f9fafb; -fx-border-color: #d1d5db; -fx-border-radius: 5px; -fx-background-radius: 5px; -fx-padding: 5px 10px;" />

    <TextField fx:id="txtCorreo" prefHeight="35.0" prefWidth="280.0" promptText="Correo Electrónico"
               style="-fx-background-color: #f9fafb; -fx-border-color: #d1d5db; -fx-border-radius: 5px; -fx-background-radius: 5px; -fx-padding: 5px 10px;" />

    <TextField fx:id="txtUsuarioNuevo" prefHeight="35.0" prefWidth="280.0" promptText="Usuario o Documento"
               style="-fx-background-color: #f9fafb; -fx-border-color: #d1d5db; -fx-border-radius: 5px; -fx-background-radius: 5px; -fx-padding: 5px 10px;" />

    <PasswordField fx:id="txtPasswordNueva" prefHeight="35.0" prefWidth="280.0" promptText="Contraseña"
                   style="-fx-background-color: #f9fafb; -fx-border-color: #d1d5db; -fx-border-radius: 5px; -fx-background-radius: 5px; -fx-padding: 5px 10px;" />

    <Button onAction="#registrarUsuario" prefHeight="38.0" prefWidth="280.0"
            style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-background-radius: 5px; -fx-cursor: hand;"
            text="Registrar Cuenta">
        <VBox.margin>
            <Insets top="5.0" />
        </VBox.margin>
    </Button>

    <Hyperlink onAction="#volverAlLogin" style="-fx-text-fill: #2563eb; -fx-font-size: 11px;" text="¿Ya tienes cuenta? Inicia sesión aquí" />

    <Label fx:id="lblMensajeRegistro" style="-fx-text-fill: #dc2626; -fx-font-size: 12px;" />

</VBox>