<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.VBox?>
<VBox alignment="TOP_LEFT" spacing="15.0" style="-fx-background-color: #121212; -fx-padding: 20;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.gymManage.controller.TuDiaController">
    <children>
        <Label style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;" text="Rutina de Hoy" />
        <Label fx:id="lblEnfoque" style="-fx-text-fill: #22c55e; -fx-font-size: 14px;" text="Cargando enfoque..." />
        <ListView fx:id="listEjercicios" prefHeight="350.0" style="-fx-background-color: #1e1e1e;" VBox.vgrow="ALWAYS" />
    </children>
</VBox>